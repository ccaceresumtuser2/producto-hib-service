        <mxCell id="leyendaOrigen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;¿Qué viene de cada arquitectura?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;De la cebolla&lt;/b&gt; (fondos de colores):&lt;br&gt;• Anillos domain → application → infrastructure&lt;br&gt;• Dependencias solo hacia el centro&lt;br&gt;• Contratos del dominio en el anillo de servicios de dominio&lt;br&gt;&lt;br&gt;&lt;b&gt;Del hexagonal&lt;/b&gt; (&lt;font color=&#39;#9C6500&#39;&gt;naranja&lt;/font&gt; = puertos, &lt;font color=&#39;#23466E&#39;&gt;azul&lt;/font&gt; = adaptadores):&lt;br&gt;• Puertos de entrada (PortIn) implementados por los casos de uso&lt;br&gt;• Puertos de salida pequeños (PortOut) en lugar de un solo IProductoRepository&lt;br&gt;• Adaptadores de entrada a la izquierda y de salida a la derecha" vertex="1">
          <mxGeometry height="250" width="520" x="200" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="leyendaFlechas" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Flechas&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;───►&lt;/b&gt; usa / depende de&lt;br&gt;&lt;b&gt;- - -▷&lt;/b&gt; implementa la interfaz&lt;br&gt;&lt;font color=&#39;#8A8A8A&#39;&gt;&lt;b&gt;- - -►&lt;/b&gt;&lt;/font&gt; Spring crea y conecta los beans&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas verificadas con ArchUnit&lt;/b&gt; (ArquitecturaHibridaTest):&lt;br&gt;• Anillos de la cebolla respetados&lt;br&gt;• Controller → solo PortIn&lt;br&gt;• application no conoce infrastructure&lt;br&gt;• domain y application sin Spring/JPA" vertex="1">
          <mxGeometry height="250" width="420" x="740" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="leyendaFlujo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Flujo: PATCH /api/productos/1/precio&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. ProductoController &lt;i&gt;(adapters/in/web)&lt;/i&gt;&lt;br&gt;2. → CambiarPrecioProductoPortIn &lt;i&gt;(application/ports/in)&lt;/i&gt;&lt;br&gt;3. &amp;nbsp;&amp;nbsp;&amp;nbsp;= CambiarPrecioProducto &lt;i&gt;(application/usecase)&lt;/i&gt;&lt;br&gt;4. → BuscarProductoPortOut.buscarPorId &lt;i&gt;(domain/ports/out)&lt;/i&gt;&lt;br&gt;5. &amp;nbsp;&amp;nbsp;&amp;nbsp;= ProductoRepositoryAdapter → PostgreSQL&lt;br&gt;6. → Producto.cambiarPrecio &lt;i&gt;(domain/model · regla de negocio)&lt;/i&gt;&lt;br&gt;7. → GuardarProductoPortOut.guardar&lt;br&gt;8. &amp;nbsp;&amp;nbsp;&amp;nbsp;= ProductoRepositoryAdapter → PostgreSQL&lt;br&gt;9. ← ProductoResponse dentro de RespuestaApi" vertex="1">
          <mxGeometry height="250" width="620" x="1180" y="1270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
